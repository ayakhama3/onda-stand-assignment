# Copiez ce fichier en ".env" (ignoré par Git) et renseignez vos propres clés.
# Ne publiez jamais vos identifiants.

# OpenSky Network — source principale de suivi ADS-B (client OAuth2)
OPENSKY_CLIENT_ID=votre_client_id
OPENSKY_CLIENT_SECRET=votre_client_secret

# AviationStack — optionnel
AVIATIONSTACK_ACCESS_KEY=votre_cle_api
